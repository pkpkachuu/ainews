# ============================================================
# Frontend environment configuration
# Copy this file to `.env` in the project ROOT (not src/) and
# fill in real values.
# ============================================================

# URL of the backend API. Defaults to http://localhost:8000 if
# unset, so this only needs to be changed for a non-default
# backend port or a deployed backend URL.
VITE_API_URL=http://localhost:8000
