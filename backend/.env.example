# ============================================================
# Backend environment configuration
# Copy this file to `.env` in the `backend/` directory and fill
# in real values. See README.md > Environment Variables for a
# full explanation of each variable and where to get it.
# ============================================================

# --- Supabase / PostgreSQL (all required) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:6543/postgres

# --- Redis (required, defaults work for local Docker setup) ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch (required, defaults work for local Docker setup) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Groq LLM (required for Intelligence Feed, Timeline, Trend Explanation) ---
GROQ_API_KEY=your-groq-api-key-here

# --- News APIs (optional, RSS ingestion works without this) ---
NEWSAPI_KEY=

# --- App settings (optional, these defaults are fine) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
